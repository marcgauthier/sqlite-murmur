@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
function(_sqlite_express_import name filename)
  if(NOT TARGET sqlite_express::${name})
    add_library(sqlite_express::${name} STATIC IMPORTED)
    set_target_properties(sqlite_express::${name} PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/${filename}")
  endif()
endfunction()
_sqlite_express_import(sqlite3 "@CMAKE_STATIC_LIBRARY_PREFIX@sqlite_express_sqlite@CMAKE_STATIC_LIBRARY_SUFFIX@")
set_target_properties(sqlite_express::sqlite3 PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
  INTERFACE_LINK_LIBRARIES "Threads::Threads;@CMAKE_DL_LIBS@;@SQLITE_EXPRESS_MATH_LIBRARY@")
_sqlite_express_import(rocksdb "@CMAKE_STATIC_LIBRARY_PREFIX@rocksdb@CMAKE_STATIC_LIBRARY_SUFFIX@")
set_target_properties(sqlite_express::rocksdb PROPERTIES INTERFACE_LINK_LIBRARIES "Threads::Threads;@CMAKE_DL_LIBS@")
_sqlite_express_import(zstd "@CMAKE_STATIC_LIBRARY_PREFIX@zstd@CMAKE_STATIC_LIBRARY_SUFFIX@")
_sqlite_express_import(crypto "libcrypto.a")
set_target_properties(sqlite_express::crypto PROPERTIES INTERFACE_LINK_LIBRARIES "Threads::Threads;@CMAKE_DL_LIBS@")
if(@SQLITE_EXPRESS_ENABLE_AEGIS256@)
  _sqlite_express_import(aegis "@CMAKE_STATIC_LIBRARY_PREFIX@aegis@CMAKE_STATIC_LIBRARY_SUFFIX@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/sqlite_expressTargets.cmake")
check_required_components(sqlite_express)
